# Model sağlayıcısı: init_chat_model'in tanıdığı herhangi bir ad (ör. anthropic, groq, ollama, openai, google_genai).
# Kurulum varsayılanı anthropic'tir; satır boşsa ya da silinirse kod groq'a düşer.
LLM_PROVIDER=anthropic
# anthropic, openai ve google_genai için zorunlu; groq ve ollama'da boşsa sağlayıcının kendi varsayılanı kullanılır
LLM_MODEL=claude-sonnet-5-5
# Yalnızca LLM_PROVIDER=groq iken okunur (boşsa groq'ta LLM_API_KEY kullanılır)
GROQ_API_KEY=
# Sağlayıcı anahtarı (kurulum varsayılanında Anthropic anahtarı, sk-ant-...); anthropic, openai ve google_genai için zorunlu, ollama için kullanılmaz
LLM_API_KEY=
# Verilirse base_url olarak geçirilir (OpenAI uyumlu servisler); ollama ile birlikte verilemez, OLLAMA_BASE_URL kullan
LLM_BASE_URL=
# Boşsa 0; none yazılırsa istekte temperature alanı gönderilmez. claude-sonnet-5-5 none ister: 0 ile her çağrı yerelde
# reddedilir ve bütün kurallar "bulunamadı" çıkar. none groq ile kullanılamaz.
LLM_TEMPERATURE=none
# Çağrı başına çıktı sınırı; boşsa 2048
LLM_MAX_TOKENS=
# Docker build argümanı: imaja kurulacak isteğe bağlı sağlayıcı paketleri (boşlukla ayrılmış); tanımsızsa "openai anthropic google", boş bırakılırsa hiçbiri.
# Bu yüzden varsayılanı korumak için satır yorumda kalır; açıp boş bırakma.
# LLM_EXTRAS=
# Ücretsiz seçenek (Groq): yukarıdaki satırları şöyle değiştir. Anahtarı GROQ_API_KEY'e yaz; o boşken LLM_API_KEY'de
# başka sağlayıcının anahtarı kalırsa o anahtar Groq'a gönderilir.
# LLM_PROVIDER=groq
# LLM_MODEL=
# LLM_TEMPERATURE=
# GROQ_API_KEY=gsk_...
# OpenAI uyumlu bir adres için örnek (yukarıdaki dört satırı doldurmak yeter):
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# Çevrimdışı modda offline
COMPOSE_PROFILES=
# Boşsa Compose dışında http://localhost:11434, Compose içinde http://ollama:11434; host Ollama: http://host.docker.internal:11434
OLLAMA_BASE_URL=
LLM_NUM_CTX=
# Boşsa 1; yüksek limitli Groq hesabında (250K TPM) 4 yapılabilir
MAX_CONCURRENCY=
# Anahtar -> tenant, rol ve görünen ad eşlemesi (tek satır JSON)
TENANT_API_KEYS='{"change-me-acme-lawyer": {"tenant_id": "acme", "role": "lawyer", "name": "Ayşe Yılmaz"}, "change-me-acme-viewer": {"tenant_id": "acme", "role": "viewer", "name": "Mehmet Demir"}, "change-me-globex-lawyer": {"tenant_id": "globex", "role": "lawyer", "name": "Elif Kaya"}, "change-me-globex-viewer": {"tenant_id": "globex", "role": "viewer", "name": "Can Öztürk"}}'
DATA_DIR=

# LangSmith: yalnızca eval için; uygulamada açarsan gerçek sözleşmelerin maskeli trace'i dışarı gider.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
